{
  "name": "skillcrew-site",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Website and documentation of Skillcrew",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "check:links": "node scripts/check-links.mjs dist",
    "test": "npm run check && npm run build && npm run validate:html && npm run check:links"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource/geist-mono": "5.3.0",
    "@fontsource/geist-sans": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@resvg/resvg-js": "2.6.2",
    "html-validate": "11.16.2",
    "pagefind": "1.5.2",
    "satori": "0.47.1",
    "satteri": "0.10.5",
    "shiki": "4.5.0",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}

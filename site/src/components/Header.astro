---
import { REPO_URL } from '../lib/site';

interface Props {
  current?: 'home' | 'docs';
}
const { current } = Astro.props;
---

<header class="sticky top-0 z-30 border-b border-line bg-bg">
  <div class="wrap flex h-14 items-center gap-4">
    <a href="/" class="mr-auto inline-flex items-center gap-2 text-[0.9375rem] font-semibold tracking-tight" aria-label="Skillcrew home">
      <svg class="h-2.5 w-2.5" viewBox="0 0 12 12" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="5" fill="var(--amber)"></circle></svg>
      <span>Skillcrew</span>
    </a>
    <nav aria-label="Main" class="flex items-center gap-1 sm:gap-2 text-sm">
      <a
        href="/docs/"
        class:list={['px-2 py-2 hover:text-amber', current === 'docs' ? 'text-amber' : 'text-text']}
        aria-current={current === 'docs' ? 'page' : undefined}>Docs</a
      >
      <a href={REPO_URL} class="px-2 py-2 text-text hover:text-amber">GitHub</a>
      <button
        type="button"
        data-search-open
        class="ml-1 inline-flex items-center gap-3 rounded-md border border-line px-3 py-1.5 text-muted hover:text-text hover:border-muted"
        aria-haspopup="dialog"
        aria-controls="search"
      >
        <span>Search</span>
        <kbd class="hidden sm:inline text-xs text-muted" data-search-kbd>Ctrl K</kbd>
      </button>
    </nav>
  </div>
</header>
